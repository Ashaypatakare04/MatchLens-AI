{
  "name": "matchlens-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "npx --yes tsx scripts/test-database-phase1.ts && npx --yes tsx scripts/run-edge-cases.ts && npx --yes tsx scripts/run-ai-benchmark.ts",
    "test:db": "npx --yes tsx scripts/test-database-phase1.ts",
    "test:edge-cases": "npx --yes tsx scripts/run-edge-cases.ts",
    "test:benchmark": "npx --yes tsx scripts/run-ai-benchmark.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "npx --yes tsx lib/db/migrate.ts",
    "db:seed": "npx --yes tsx lib/db/seed.ts",
    "db:migrate-legacy": "npx --yes tsx scripts/migrate-from-json.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@google/genai": "^2.27.0",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.52.0",
    "mammoth": "^1.13.0",
    "next": "16.3.8",
    "pg": "^8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.7.0",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "tsx": "^4.19.3",
    "typescript": "^5"
  }
}
