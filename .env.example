# MatchLens AI - Environment Configuration Template
# Copy this file to .env.local for local development.

# Database Configuration (PostgreSQL)
# For remote PostgreSQL (e.g. Neon, Supabase, AWS RDS, Docker):
# DATABASE_URL="postgresql://postgres:password@localhost:5432/matchlens?sslmode=disable"
# When omitted in local development/testing, the system uses embedded PostgreSQL WASM (@electric-sql/pglite).
DATABASE_URL=

# AI & Semantic Enrichment (Optional - falls back to deterministic local semantic engine when omitted)
GEMINI_API_KEY=

# Node Environment
NODE_ENV=development

# Authentication & Session Security (NextAuth / Auth.js)
# Required in production: generate a 32+ char secret using `openssl rand -base64 32`
AUTH_SECRET="matchlens-dev-secret-key-32-chars-long-minimum-secure"
NEXTAUTH_URL="http://localhost:3000"

# Private Object Storage Configuration (Phase 3)
# When S3 credentials are omitted, MatchLens defaults to local AES-256-GCM encrypted storage (.data/storage/).
# For production (AWS S3, Cloudflare R2, MinIO):
# S3_BUCKET_NAME="matchlens-resumes-prod"
# S3_REGION="auto"
# S3_ACCESS_KEY_ID="your-s3-or-r2-access-key-id"
# S3_SECRET_ACCESS_KEY="your-s3-or-r2-secret-access-key"
# S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
S3_BUCKET_NAME=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# Data Retention & GDPR Policies (Phase 3)
# Number of days before candidate resume documents expire and become eligible for automated pruning.
RESUME_RETENTION_DAYS=180

# Asynchronous Background Processing & Worker (Phase 4)
# Concurrency limit for background resume evaluation worker (default: 5)
WORKER_CONCURRENCY=5
# Polling interval in milliseconds for the background worker loop (default: 1000ms)
WORKER_POLL_INTERVAL_MS=1000
# Timeout in milliseconds after which an active worker heartbeat is considered stale/crashed (default: 300000ms / 5min)
WORKER_STALE_TIMEOUT_MS=300000
# Optional external Redis connection URL for BullMQ scaling mode:
# REDIS_URL="redis://localhost:6379"
REDIS_URL=

# Observability, Structured Logging & Monitoring (Phase 6)
# Minimum log level: debug | info | warn | error | fatal (default: info)
LOG_LEVEL=info
# Log format: json | text (defaults to json in production)
LOG_FORMAT=json
# Dedicated bearer token for automated Prometheus/Datadog scraping of /api/admin/monitoring
# Generate via `openssl rand -hex 24`
MONITORING_API_KEY=
# Optional Sentry DSN for production exception telemetry (omitted in local dev)
SENTRY_DSN=



